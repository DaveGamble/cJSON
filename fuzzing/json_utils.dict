#
# AFL dictionary for JSON
# -----------------------------
#

object_start="{"
object_end="}"
object_empty="{}"
object_one_element="{\"one\":1}"
object_two_elements="{\"1\":1,\"2\":2}"
object_separator=":"

array_start="["
array_end="]"
array_empty="[]"
array_one_element="[1]"
array_two_elements="[1,2]"

separator=","

escape_sequence_b="\\b"
escape_sequence_f="\\f"
escape_sequence_n="\\n"
escape_sequence_r="\\r"
escape_sequence_t="\\t"
escape_sequence_quote="\\\""
escape_sequence_backslash="\\\\"
escape_sequence_slash="\\/"
escape_sequence_utf16_base="\\u"
escape_sequence_utf16="\\u12ab"

number_integer="1"
number_double="1.0"
number_negative_integer="-1"
number_negative_double="-1.0"
number_engineering1="1e1"
number_engineering2="1e-1"
number_positive_integer="+1"
number_positive_double="+1.0"
number_e="e"
number_plus="+"
number_minus="-"
number_separator="."

null="null"
true="true"
false="false"

# cJSON_Utils additions: RFC 6902 patch keywords, RFC 6901 pointer tokens
patch_add="\"op\":\"add\""
patch_remove="\"op\":\"remove\""
patch_replace="\"op\":\"replace\""
patch_move="\"op\":\"move\""
patch_copy="\"op\":\"copy\""
patch_test="\"op\":\"test\""
patch_field_op="\"op\""
patch_field_path="\"path\""
patch_field_value="\"value\""
patch_field_from="\"from\""
pointer_root="/"
pointer_index0="/0"
pointer_index1="/1"
pointer_end="-"
pointer_escape_tilde="~0"
pointer_escape_slash="~1"
pointer_member="/a"
pointer_nested="/a/0/b"
